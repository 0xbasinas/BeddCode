{
  "name": "electron-chrome-extensions",
  "version": "4.10.0-beddcode.1",
  "description": "Vendored Chrome extension API support for Electron, adapted for BeddCode",
  "license": "MIT",
  "private": true,
  "main": "./src/index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
