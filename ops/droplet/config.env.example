# config.env.example - every setting the droplet scripts read. Copy to config.env and edit.
# up.sh / down.sh read it locally; bootstrap.sh reads it on the droplet (it is copied there with the folder).
# NO SECRETS HERE: no API keys, tokens, passwords or keystores. config.env is git-ignored anyway.

# --- DigitalOcean (used by up.sh / down.sh) ---------------------------------
DROPLET_NAME="devbox"
DROPLET_SIZE="s-4vcpu-8gb-intel"    # Intel hosts expose /dev/kvm (nested KVM) for the emulator; doctl compute size list
SSH_KEY_IDS="57830904"              # "digitalocean windows laptop" (~/.ssh/id_ed25519); doctl compute ssh-key list
DROPLET_REGION="fra1"
BASE_IMAGE="ubuntu-24-04-x64"       # only for the very first droplet (up.sh --fresh)
SNAPSHOT_PREFIX="devbox"            # snapshots are named <prefix>-YYYYMMDD-HHMM
SNAPSHOTS_TO_KEEP=2                 # down.sh deletes older ones only after a new one succeeded
SSH_KEY_FILE="$HOME/.ssh/id_ed25519"
BILLING_WARN_USD=40                 # warn when month-to-date usage is above this
SNAPSHOT_USD_PER_GB=0.06            # DigitalOcean snapshot price per GB-month

# --- Droplet setup (used by bootstrap.sh) -----------------------------------
DEV_USER="dev"
GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"
NODE_VERSION="22"                   # installed with nvm
NVM_VERSION="v0.40.8"
SWAP_SIZE_GB=6
SWAPPINESS=10

# BeddCode host: the relay URL is not a secret; the relay password is (set it by hand, see README).
BEDDCODE_RELAY_URL="https://your-relay.example.workers.dev"

# Android SDK (matches react-native 0.88 / Expo SDK 58: compileSdk 37, targetSdk 36, NDK 27.1).
ANDROID_CMDLINE_TOOLS_ZIP="commandlinetools-linux-15859902_latest.zip"
ANDROID_CMDLINE_TOOLS_SHA256="4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583"
# From API 37 the platform carries its minor version: platforms;android-37.0 (AGP 9.2 resolves compileSdk 37 to it).
ANDROID_PACKAGES="platform-tools platforms;android-36 platforms;android-37.0 build-tools;36.0.0 build-tools;37.0.0 ndk;27.1.12297006 cmake;3.22.1"

# Extras
INSTALL_MAESTRO=1
INSTALL_EMULATOR=1                  # emu-setup.sh still stops if /dev/kvm is missing
EMULATOR_IMAGE="system-images;android-36;google_apis;x86_64"
AVD_NAME="pixel36"
