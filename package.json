{
  "name": "beddcode",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @beddcode/web build && e2e run",
    "test:e2e:real": "pnpm --filter @beddcode/web build && e2e run --config e2e.real.config.ts",
    "test:e2e:concurrency": "pnpm --filter @beddcode/web build && e2e run --config e2e.concurrent.config.ts",
    "test:e2e:realistic": "pnpm --filter @beddcode/web build && e2e run --config e2e.realistic.config.ts",
    "test:desktop": "pnpm --filter @beddcode/web build && pnpm --filter @beddcode/desktop bundle && vitest run --config vitest.desktop.config.ts",
    "test:relay": "vitest run --config vitest.relay.config.ts",
    "test:desktop:real": "pnpm --filter @beddcode/web build && pnpm --filter @beddcode/desktop bundle && vitest run --config vitest.desktop.real.config.ts",
    "test:e2e:scenarios": "pnpm --filter @beddcode/web build && e2e run --config e2e.scenarios.config.ts",
    "lint": "oxlint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "dist": "pnpm --filter @beddcode/web build && pnpm --filter @beddcode/desktop dist",
    "dist:win": "pnpm --filter @beddcode/web build && pnpm --filter @beddcode/desktop dist:win",
    "dist:linux": "pnpm --filter @beddcode/web build && pnpm --filter @beddcode/desktop dist:linux"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.3",
    "@resvg/resvg-js": "^2.6.2",
    "e2e": "0.21.3",
    "oxlint": "^1.0.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
