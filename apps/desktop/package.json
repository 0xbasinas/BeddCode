{
  "name": "@beddcode/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "dev": "wait-on tcp:5173 && pnpm bundle && cross-env BEDDCODE_WEB_URL=http://localhost:5173 electron .",
    "start": "pnpm bundle && electron .",
    "build": "pnpm bundle",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@beddcode/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "esbuild": "^0.25.0",
    "wait-on": "^8.0.0"
  }
}
